# Comic Chaos configuration. Copy this file to .env and fill in your own values.
# .env is ignored by git — never commit it or paste its contents anywhere.

# Required for generating comics. Create a key at https://platform.openai.com/api-keys
# Every comic you create is billed to this key's OpenAI account.
OPENAI_API_KEY=your_openai_api_key_here

# --- Optional -----------------------------------------------------------------

# Address and port for `python -m comic_chaos`. The default 127.0.0.1 keeps the app
# reachable from this computer only; Comic Chaos has no login. (Docker sets
# its own HOST inside the container.)
# HOST=127.0.0.1
# PORT=5000

# Set to false to switch off comic generation (the UI still loads).
# API_ENABLED=true

# Use these models for every comic instead of each comic's config.json.
# COMIC_CHAOS_LLM_MODEL=
# COMIC_CHAOS_IMAGE_MODEL=

# Flask debug mode with auto-reload (only allowed when HOST is 127.0.0.1).
# DEBUG=false
